#!/usr/bin/env bash
# Tests the release scripts in this directory. Stubs replace curl and gh, so
# nothing touches the network or GitHub. Run it from anywhere.
set -euo pipefail

scripts=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/run-tests.XXXXXX")
trap 'rm -rf "$work"' EXIT
failures=0

# expect <name> <status> <command...> checks the command's exit status.
expect() {
  local name=$1 want=$2 got=0
  shift 2
  "$@" > "$work/out" 2>&1 || got=$?
  if [ "$got" = "$want" ]; then
    echo "ok   $name"
  else
    echo "FAIL $name: exit $got, want $want"
    sed 's/^/     /' "$work/out"
    failures=$((failures + 1))
  fi
}

# expect_output <name> <text> fails unless the last command printed <text>.
expect_output() {
  if grep -qF -- "$2" "$work/out"; then
    echo "ok   $1"
  else
    echo "FAIL $1: output lacks \"$2\""
    sed 's/^/     /' "$work/out"
    failures=$((failures + 1))
  fi
}

mkdir "$work/bin"
export PATH="$work/bin:$PATH"

# crate-published -------------------------------------------------------------

# Answers with FAKE_STATUS and the body in FAKE_BODY.
cat > "$work/bin/curl" <<'EOF'
#!/usr/bin/env bash
while [ "$#" -gt 0 ]; do
  if [ "$1" = -o ]; then
    printf '%s' "$FAKE_BODY" > "$2"
    shift
  fi
  shift
done
printf '%s' "$FAKE_STATUS"
EOF
chmod +x "$work/bin/curl"

index=$'{"name":"scidtopgn","vers":"0.1.0"}\n{"name":"scidtopgn","vers":"0.1.1"}\n'
FAKE_STATUS=200 FAKE_BODY=$index expect "crate-published: listed version" 0 "$scripts/crate-published" scidtopgn 0.1.1
FAKE_STATUS=200 FAKE_BODY=$index expect "crate-published: unlisted version" 1 "$scripts/crate-published" scidtopgn 0.2.0
FAKE_STATUS=404 FAKE_BODY="" expect "crate-published: unknown crate" 1 "$scripts/crate-published" scidtopgn 0.1.0
FAKE_STATUS=200 FAKE_BODY=$'{"vers":"0.1.0"}\n{not json\n' expect "crate-published: malformed index" 2 "$scripts/crate-published" scidtopgn 0.1.0
FAKE_STATUS=500 FAKE_BODY="" expect "crate-published: server error" 2 "$scripts/crate-published" scidtopgn 0.1.0
expect "crate-published: missing argument" 2 "$scripts/crate-published" scidtopgn

# pending-changesets ----------------------------------------------------------

repo="$work/repo"
git init -q "$repo"
git_commit() {
  git -C "$repo" add -A
  git -C "$repo" -c user.name=test -c user.email=test@example.com commit -q -m "$1"
}
changeset() {
  mkdir -p "$repo/.changeset"
  printf -- '---\ndefault: %s\n---\n\n# %s\n\nDetails about the change.\nMore details.\n' "$2" "$3" > "$repo/.changeset/$1.md"
}
set_version() {
  printf '[workspace.package]\nversion = "%s"\n' "$1" > "$repo/Cargo.toml"
}
pending() {
  (cd "$repo" && "$scripts/pending-changesets" "$@")
}

set_version 0.1.0
git_commit "release 0.1.0"
expect "pending-changesets: stable, none" 0 pending 0.1.0

changeset add-thing minor "Add a thing"
git_commit "add a changeset"
expect "pending-changesets: stable, one left over" 1 pending 0.1.0
expect_output "pending-changesets: lists the left-over changeset" ".changeset/add-thing.md"

set_version 0.1.1-rc.0
git_commit "prepare 0.1.1-rc.0"
expect "pending-changesets: prerelease, nothing new" 0 pending 0.1.1-rc.0

changeset fix-thing patch "Fix a thing"
git_commit "add a changeset after the prerelease"
expect "pending-changesets: prerelease, added changeset" 1 pending 0.1.1-rc.0

set_version 0.1.1-rc.1
git_commit "prepare 0.1.1-rc.1"
echo "Another detail." >> "$repo/.changeset/add-thing.md"
git_commit "edit a changeset"
expect "pending-changesets: prerelease, edited changeset" 1 pending 0.1.1-rc.1

set_version 0.1.1-rc.2
git_commit "prepare 0.1.1-rc.2"
git -C "$repo" mv .changeset/fix-thing.md .changeset/fix-the-thing.md
echo "One more detail." >> "$repo/.changeset/fix-the-thing.md"
git_commit "rename and edit a changeset"
expect "pending-changesets: prerelease, renamed and edited changeset" 1 pending 0.1.1-rc.2
expect_output "pending-changesets: lists the renamed changeset" ".changeset/fix-the-thing.md"

expect "pending-changesets: version never set" 2 pending 0.9.0-rc.0
expect "pending-changesets: missing argument" 2 pending

# sync-release-assets ---------------------------------------------------------

# A release whose assets are files in $FAKE_RELEASE/<state>/. Each upload is
# logged to $FAKE_RELEASE/log.
cat > "$work/bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob
release=$FAKE_RELEASE
case "$1 $2" in
  "release view")
    for state in uploaded starter; do
      for file in "$release/$state"/*; do
        jq -n --arg name "$(basename "$file")" --arg state "$state" '{name: $name, state: $state}'
      done
    done | jq -s '{assets: .}'
    ;;
  "release delete-asset")
    rm -f "$release/uploaded/$4" "$release/starter/$4"
    ;;
  "release upload")
    cp "$4" "$release/uploaded/"
    echo "upload $(basename "$4")" >> "$release/log"
    ;;
  "release download")
    cp "$release/uploaded"/* "$5/"
    ;;
  *)
    echo "gh stub: unexpected arguments: $*" >&2
    exit 64
    ;;
esac
EOF
chmod +x "$work/bin/gh"

new_release() {
  export FAKE_RELEASE="$work/release-$1"
  mkdir -p "$FAKE_RELEASE/uploaded" "$FAKE_RELEASE/starter"
  : > "$FAKE_RELEASE/log"
  dist="$work/dist-$1"
  mkdir -p "$dist"
  echo "linux build $1" > "$dist/scidtopgn-v0.1.0-x86_64-unknown-linux-gnu.tar.gz"
  echo "windows build $1" > "$dist/scidtopgn-v0.1.0-x86_64-pc-windows-msvc.zip"
}
sync() {
  "$scripts/sync-release-assets" v0.1.0 "$dist"
}
uploads() {
  sort "$FAKE_RELEASE/log" | tr '\n' ' '
}

new_release fresh
expect "sync-release-assets: empty release" 0 sync
expect_output "sync-release-assets: checks the archives" "scidtopgn-v0.1.0-x86_64-unknown-linux-gnu.tar.gz: OK"
expect "sync-release-assets: uploads every archive and SHA256SUMS" 0 \
  test "$(uploads)" = "upload SHA256SUMS upload scidtopgn-v0.1.0-x86_64-pc-windows-msvc.zip upload scidtopgn-v0.1.0-x86_64-unknown-linux-gnu.tar.gz "
expect "sync-release-assets: rerun on a finished release" 0 sync
expect "sync-release-assets: rerun uploads nothing" 0 \
  test "$(uploads)" = "upload SHA256SUMS upload scidtopgn-v0.1.0-x86_64-pc-windows-msvc.zip upload scidtopgn-v0.1.0-x86_64-unknown-linux-gnu.tar.gz "

# An earlier attempt uploaded the Linux archive from a different build, then
# failed with the Windows archive and SHA256SUMS left in the "starter" state.
new_release partial
echo "linux build from an earlier run" > "$FAKE_RELEASE/uploaded/scidtopgn-v0.1.0-x86_64-unknown-linux-gnu.tar.gz"
: > "$FAKE_RELEASE/starter/scidtopgn-v0.1.0-x86_64-pc-windows-msvc.zip"
: > "$FAKE_RELEASE/starter/SHA256SUMS"
expect "sync-release-assets: rerun with unfinished uploads" 0 sync
expect_output "sync-release-assets: deletes the unfinished archive" "Deleting scidtopgn-v0.1.0-x86_64-pc-windows-msvc.zip, an unfinished upload (starter)."
expect "sync-release-assets: uploads only what was unfinished" 0 \
  test "$(uploads)" = "upload SHA256SUMS upload scidtopgn-v0.1.0-x86_64-pc-windows-msvc.zip "
expect "sync-release-assets: keeps the finished archive" 0 \
  grep -qx "linux build from an earlier run" "$FAKE_RELEASE/uploaded/scidtopgn-v0.1.0-x86_64-unknown-linux-gnu.tar.gz"
expect "sync-release-assets: leaves no unfinished assets" 0 test -z "$(ls -A "$FAKE_RELEASE/starter")"

new_release tampered
expect "sync-release-assets: setup for tampering" 0 sync
echo "replaced by hand" > "$FAKE_RELEASE/uploaded/scidtopgn-v0.1.0-x86_64-pc-windows-msvc.zip"
expect "sync-release-assets: archive doesn't match SHA256SUMS" 1 sync

new_release missing
expect "sync-release-assets: setup for a missing archive" 0 sync
echo "extra build" > "$dist/scidtopgn-v0.1.0-aarch64-apple-darwin.tar.gz"
expect "sync-release-assets: SHA256SUMS lacks a built archive" 1 sync

# rust-std-licenses and copy-rust-std-notices ---------------------------------

# A toolchain whose COPYRIGHT-library.html has the format of Rust 1.99.1's.
# The out-of-tree section names a license that the in-tree section doesn't.
sysroot="$work/sysroot"
rust_docs="$sysroot/share/doc/rust"
mkdir -p "$rust_docs/licenses"
cat > "$rust_docs/COPYRIGHT-library.html" <<'HTML'
<h2 id="in-tree-files">In-tree files</h2>
    <p><b>File/Directory:</b> <code>.</code></p>
    <p><b>License:</b> Apache-2.0 OR MIT</p>
    <p><b>File/Directory:</b> <code>library/core/src/unicode</code></p>
    <p><b>License:</b> Unicode-3.0</p>
    <p><b>License:</b> BSD-2-Clause AND (Apache-2.0 OR MIT)</p>
<h2 id="out-of-tree-dependencies">Out-of-tree dependencies</h2>
    <p><b>License:</b> Unlicense OR MIT</p>
    <pre>Copyright (c) Some Crate Author</pre>
HTML
for id in Apache-2.0 MIT Unicode-3.0 BSD-2-Clause Unlicense; do
  echo "Text of $id" > "$rust_docs/licenses/$id.txt"
done
cat > "$work/bin/rustc" <<'STUB'
#!/usr/bin/env bash
[ "$*" = "--print sysroot" ] && echo "$FAKE_SYSROOT"
STUB
chmod +x "$work/bin/rustc"
export FAKE_SYSROOT="$sysroot"

expect "rust-std-licenses: in-tree licenses" 0 \
  test "$("$scripts/rust-std-licenses" "$rust_docs/COPYRIGHT-library.html" | tr '\n' ' ')" = "Apache-2.0 BSD-2-Clause MIT Unicode-3.0 "
printf '<h2 id="in-tree-files">In-tree files</h2>\n<p>Nothing</p>\n' > "$work/no-licenses.html"
expect "rust-std-licenses: no in-tree licenses" 1 "$scripts/rust-std-licenses" "$work/no-licenses.html"

expect "copy-rust-std-notices: copies the notices" 0 "$scripts/copy-rust-std-notices" "$work/std-copy"
expect "copy-rust-std-notices: copies COPYRIGHT-library.html" 0 \
  cmp "$rust_docs/COPYRIGHT-library.html" "$work/std-copy/COPYRIGHT-library.html"
expect "copy-rust-std-notices: copies only the in-tree licenses" 0 \
  test "$(ls "$work/std-copy/licenses" | tr '\n' ' ')" = "Apache-2.0.txt BSD-2-Clause.txt MIT.txt Unicode-3.0.txt "
mv "$rust_docs/licenses/Unicode-3.0.txt" "$work/Unicode-3.0.txt"
expect "copy-rust-std-notices: toolchain lacks a license text" 1 "$scripts/copy-rust-std-notices" "$work/std-missing"
mv "$work/Unicode-3.0.txt" "$rust_docs/licenses/Unicode-3.0.txt"
FAKE_SYSROOT="$work/no-sysroot" expect "copy-rust-std-notices: toolchain without notices" 1 \
  "$scripts/copy-rust-std-notices" "$work/std-none"

# check-archive-notices -------------------------------------------------------

sources="$work/sources"
mkdir -p "$sources/alpha-1.0.0" "$sources/beta_rs-0.2.1" "$sources/gamma-3.0.0"
printf 'Copyright (c) 2020 Alpha Author\n\nPermission is hereby granted, free of charge.\n' > "$sources/alpha-1.0.0/LICENSE-MIT"
printf 'Apache text\n' > "$sources/alpha-1.0.0/LICENSE-APACHE"
printf '    MIT License\n\n    Copyright (c) Beta Corporation.\n\n    The above copyright notice shall be included.\n' > "$sources/beta_rs-0.2.1/license-mit"
crates=$'scidtopgn-cli v0.1.0 (/src/crates/scidtopgn-cli)\nalpha v1.0.0\nbeta_rs v0.2.1\nalpha v1.0.0\nbeta_rs v0.2.1 (*)\n'
notices_full=$'Crate        License used\nalpha 1.0.0  MIT\nbeta_rs 0.2.1  MIT\n\n====\n\nalpha 1.0.0\n\nCopyright (c) 2020 Alpha Author\n\nPermission is hereby granted,\nfree of charge.\n\n====\n\nbeta_rs 0.2.1\n\nMIT License\nCopyright (c) Beta Corporation.\nThe above copyright notice shall be included.\n'

# archive <name> <notices> [no-std] writes <name>.tar.gz with
# <name>/THIRD_PARTY_LICENSES, or none when <notices> is "-", and the
# toolchain's rust-std-licenses unless no-std is given.
archive() {
  mkdir -p "$work/archives/$1"
  if [ "$2" != - ]; then
    printf '%s' "$2" > "$work/archives/$1/THIRD_PARTY_LICENSES"
  fi
  if [ "${3:-}" != no-std ]; then
    "$scripts/copy-rust-std-notices" "$work/archives/$1/rust-std-licenses"
  fi
  tar -czf "$work/$1.tar.gz" -C "$work/archives" "$1"
}
check_notices() {
  printf '%s' "$crates" | "$scripts/check-archive-notices" "$work/$1" "$sources" "$rust_docs"
}

archive full "$notices_full"
expect "check-archive-notices: everything covered" 0 check_notices full.tar.gz
expect_output "check-archive-notices: skips workspace and repeated crates" "the notices of 2 crates"
expect_output "check-archive-notices: lists the standard library's licenses" "Apache-2.0 BSD-2-Clause MIT Unicode-3.0"

unlisted=${notices_full/beta_rs 0.2.1  MIT/}
archive unlisted "${unlisted/$'\nbeta_rs 0.2.1\n'/$'\n'}"
expect "check-archive-notices: crate not listed" 1 check_notices unlisted.tar.gz
expect_output "check-archive-notices: names the unlisted crate" "doesn't list beta_rs 0.2.1"

archive no-copyright "${notices_full/Copyright (c) 2020 Alpha Author/}"
expect "check-archive-notices: copyright line missing" 1 check_notices no-copyright.tar.gz
expect_output "check-archive-notices: names the incomplete notice" "lacks the text of alpha 1.0.0's LICENSE-MIT"

archive no-notices -
expect "check-archive-notices: archive without THIRD_PARTY_LICENSES" 1 check_notices no-notices.tar.gz

crates+=$'gamma v3.0.0\n'
archive gamma "$notices_full"$'gamma 3.0.0  MIT\n'
expect "check-archive-notices: crate without a license file" 1 check_notices gamma.tar.gz
expect_output "check-archive-notices: names the crate without a license file" "No MIT license file for gamma 3.0.0"
crates=${crates%$'gamma v3.0.0\n'}

# delta has no license file. It is under GPL-3.0-or-later, whose text is the
# archive's LICENSE.
mkdir -p "$sources/delta-4.0.0"
crates+=$'delta v4.0.0\n'
archive delta-gpl "$notices_full"$'delta 4.0.0  GPL-3.0-or-later\n'
printf '                    GNU GENERAL PUBLIC LICENSE\n                       Version 3, 29 June 2007\n' > "$work/archives/delta-gpl/LICENSE"
tar -czf "$work/delta-gpl.tar.gz" -C "$work/archives" delta-gpl
expect "check-archive-notices: GPL crate covered by LICENSE" 0 check_notices delta-gpl.tar.gz
archive delta-no-license "$notices_full"$'delta 4.0.0  GPL-3.0-or-later\n'
expect "check-archive-notices: GPL crate without LICENSE" 1 check_notices delta-no-license.tar.gz
expect_output "check-archive-notices: names the GPL crate without LICENSE" "No MIT license file for delta 4.0.0"
archive delta-mit "$notices_full"$'delta 4.0.0  MIT\n'
printf 'Version 3, 29 June 2007\n' > "$work/archives/delta-mit/LICENSE"
tar -czf "$work/delta-mit.tar.gz" -C "$work/archives" delta-mit
expect "check-archive-notices: crate without a license file listed as MIT" 1 check_notices delta-mit.tar.gz
crates=${crates%$'delta v4.0.0\n'}

archive no-std "$notices_full" no-std
expect "check-archive-notices: archive without rust-std-licenses" 1 check_notices no-std.tar.gz
expect_output "check-archive-notices: names the missing standard library notices" "rust-std-licenses/COPYRIGHT-library.html is missing"

archive std-other "$notices_full"
echo "<!-- another toolchain -->" >> "$work/archives/std-other/rust-std-licenses/COPYRIGHT-library.html"
tar -czf "$work/std-other.tar.gz" -C "$work/archives" std-other
expect "check-archive-notices: COPYRIGHT-library.html from another toolchain" 1 check_notices std-other.tar.gz

archive no-unicode "$notices_full"
rm "$work/archives/no-unicode/rust-std-licenses/licenses/Unicode-3.0.txt"
tar -czf "$work/no-unicode.tar.gz" -C "$work/archives" no-unicode
expect "check-archive-notices: Unicode license text missing" 1 check_notices no-unicode.tar.gz
expect_output "check-archive-notices: names the missing license text" "rust-std-licenses/licenses/Unicode-3.0.txt is missing"

if command -v zip > /dev/null; then
  (cd "$work/archives" && zip -qr "$work/full.zip" full)
  expect "check-archive-notices: zip archive" 0 check_notices full.zip
fi

expect "check-archive-notices: no crates on stdin" 2 \
  "$scripts/check-archive-notices" "$work/full.tar.gz" "$sources" "$rust_docs" < /dev/null
expect "check-archive-notices: missing argument" 2 "$scripts/check-archive-notices" "$work/full.tar.gz" "$sources"

if [ "$failures" -gt 0 ]; then
  echo "$failures failed."
  exit 1
fi
echo "All passed."
